<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PaceMUN II Countdown</title>
<style>
  :root {
    --cd-bg: rgba(12, 14, 20, 0.94);
    --cd-surface: rgba(255, 255, 255, 0.07);
    --cd-border: rgba(255, 255, 255, 0.13);
    --cd-text: #ffffff;
    --cd-muted: rgba(255, 255, 255, 0.62);
    --cd-accent: #ffffff;
    --cd-radius: 20px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 220vh;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #090b10;
    color: var(--cd-text);
  }

  .demo-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 3rem 1.25rem;
    text-align: center;
  }

  .demo-page h1 { margin: 0 0 .75rem; font-size: clamp(2rem, 6vw, 4.5rem); }
  .demo-page p { margin: 0; color: var(--cd-muted); max-width: 640px; line-height: 1.7; }

  /* Countdown popup */
  .countdown-popup {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 9999;
    width: min(920px, calc(100vw - 28px));
    transform: translate(-50%, calc(100% + 32px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 720ms cubic-bezier(.22, 1, .36, 1),
      opacity 420ms ease,
      visibility 0s linear 720ms;
  }

  .countdown-popup.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      transform 720ms cubic-bezier(.22, 1, .36, 1),
      opacity 420ms ease,
      visibility 0s linear 0s;
  }

  .countdown-popup__inner {
    position: relative;
    overflow: hidden;
    padding: 18px 20px 20px;
    border: 1px solid var(--cd-border);
    border-radius: var(--cd-radius);
    background: var(--cd-bg);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    box-shadow: 0 18px 60px rgba(0,0,0,.38);
  }

  .countdown-popup__inner::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent);
    opacity: .35;
  }

  .countdown-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .countdown-heading {
    min-width: 0;
  }

  .countdown-eyebrow {
    display: block;
    margin-bottom: 3px;
    color: var(--cd-muted);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .countdown-title {
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    line-height: 1.2;
    font-weight: 750;
  }

  .countdown-date {
    flex: 0 0 auto;
    color: var(--cd-muted);
    font-size: .78rem;
    white-space: nowrap;
  }

  .countdown-clock {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: clamp(6px, 1.5vw, 14px);
  }

  .countdown-unit {
    min-width: 0;
    display: grid;
    gap: 7px;
    justify-items: center;
  }

  .countdown-value {
    position: relative;
    width: 100%;
    min-height: 68px;
    display: grid;
    place-items: center;
    padding: 8px 6px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.035));
    overflow: hidden;
    font-variant-numeric: tabular-nums;
    font-size: clamp(1.55rem, 5vw, 2.65rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.04em;
  }

  /* Rolling/flip effect */
  .countdown-value .digit {
    display: inline-block;
    will-change: transform, opacity;
  }

  .countdown-value.is-changing .digit {
    animation: rollUp 460ms cubic-bezier(.2,.8,.25,1);
  }

  @keyframes rollUp {
    0%   { transform: translateY(60%); opacity: 0; filter: blur(3px); }
    45%  { transform: translateY(-8%); opacity: 1; filter: blur(0); }
    100% { transform: translateY(0); opacity: 1; filter: blur(0); }
  }

  .countdown-label {
    color: var(--cd-muted);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .countdown-separator {
    padding-bottom: 20px;
    color: rgba(255,255,255,.42);
    font-size: clamp(1.35rem, 4vw, 2rem);
    line-height: 1;
    user-select: none;
  }

  .countdown-popup__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    color: #fff;
    cursor: pointer;
    font-size: 1.05rem;
    line-height: 1;
  }

  .countdown-popup__close:hover { background: rgba(255,255,255,.12); }
  .countdown-popup__close:focus-visible {
    outline: 2px solid rgba(255,255,255,.85);
    outline-offset: 2px;
  }

  @media (max-width: 620px) {
    .countdown-popup { bottom: 12px; width: calc(100vw - 20px); }
    .countdown-popup__inner { padding: 16px 12px 14px; }
    .countdown-topline { padding-right: 30px; }
    .countdown-date { display: none; }
    .countdown-value { min-height: 58px; border-radius: 11px; }
    .countdown-separator { padding-bottom: 18px; }
    .countdown-label { font-size: .57rem; letter-spacing: .09em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown-popup,
    .countdown-popup.is-visible {
      transition: opacity 180ms ease;
    }
    .countdown-value.is-changing .digit { animation: none; }
  }
</style>
</head>
<body>
  <main class="demo-page">
    <div>
      <h1>PaceMUN II</h1>
      <p>Scroll down the page. The countdown appears after the first scroll and rolls upward into view.</p>
    </div>
  </main>

  <section
    class="countdown-popup"
    id="countdownPopup"
    aria-label="Conference countdown"
    aria-hidden="true"
  >
    <div class="countdown-popup__inner">
      <button class="countdown-popup__close" id="countdownClose" type="button" aria-label="Close countdown">×</button>

      <div class="countdown-topline">
        <div class="countdown-heading">
          <span class="countdown-eyebrow">The countdown is on</span>
          <h2 class="countdown-title">PaceMUN II begins in</h2>
        </div>
        <div class="countdown-date">31 October 2026</div>
      </div>

      <div class="countdown-clock" id="countdownClock" role="timer" aria-live="polite" aria-atomic="true">
        <div class="countdown-unit">
          <div class="countdown-value" id="cdDays">00</div>
          <span class="countdown-label">Days</span>
        </div>
        <span class="countdown-separator" aria-hidden="true">:</span>

        <div class="countdown-unit">
          <div class="countdown-value" id="cdHours">00</div>
          <span class="countdown-label">Hours</span>
        </div>
        <span class="countdown-separator" aria-hidden="true">:</span>

        <div class="countdown-unit">
          <div class="countdown-value" id="cdMinutes">00</div>
          <span class="countdown-label">Min</span>
        </div>
        <span class="countdown-separator" aria-hidden="true">:</span>

        <div class="countdown-unit">
          <div class="countdown-value" id="cdSeconds">00</div>
          <span class="countdown-label">Sec</span>
        </div>
      </div>
    </div>
  </section>

<script>
(() => {
  "use strict";

  const popup = document.getElementById("countdownPopup");
  const closeButton = document.getElementById("countdownClose");
  const daysEl = document.getElementById("cdDays");
  const hoursEl = document.getElementById("cdHours");
  const minutesEl = document.getElementById("cdMinutes");
  const secondsEl = document.getElementById("cdSeconds");

  // Target: 31 October 2026 at 00:00:00 in the visitor's local timezone.
  const target = new Date(2026, 9, 31, 0, 0, 0);

  let lastValues = null;
  let intervalId = null;
  let closedByUser = false;
  let scrolledEnough = false;

  const pad = (value) => String(value).padStart(2, "0");

  function animateChange(element, value) {
    const next = String(value);
    if (element.textContent === next) return;

    element.textContent = next;
    element.classList.remove("is-changing");
    void element.offsetWidth;
    element.classList.add("is-changing");

    window.setTimeout(() => element.classList.remove("is-changing"), 500);
  }

  function updateCountdown() {
    const now = new Date();
    const remaining = Math.max(0, target.getTime() - now.getTime());

    const totalSeconds = Math.floor(remaining / 1000);
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;

    const values = {
      days: String(days).padStart(2, "0"),
      hours: pad(hours),
      minutes: pad(minutes),
      seconds: pad(seconds)
    };

    animateChange(daysEl, values.days);
    animateChange(hoursEl, values.hours);
    animateChange(minutesEl, values.minutes);
    animateChange(secondsEl, values.seconds);

    daysEl.setAttribute("aria-label", `${days} days`);
    hoursEl.setAttribute("aria-label", `${hours} hours`);
    minutesEl.setAttribute("aria-label", `${minutes} minutes`);
    secondsEl.setAttribute("aria-label", `${seconds} seconds`);

    const announced = `${days} days, ${hours} hours, ${minutes} minutes, ${seconds} seconds remaining`;
    document.getElementById("countdownClock").setAttribute("aria-label", announced);

    lastValues = values;

    if (remaining <= 0 && intervalId !== null) {
      window.clearInterval(intervalId);
      intervalId = null;
    }
  }

  function showPopup() {
    if (closedByUser) return;
    popup.classList.add("is-visible");
    popup.setAttribute("aria-hidden", "false");
    if (intervalId === null) {
      updateCountdown();
      intervalId = window.setInterval(updateCountdown, 1000);
    }
  }

  function hidePopup() {
    popup.classList.remove("is-visible");
    popup.setAttribute("aria-hidden", "true");
  }

  function handleScroll() {
    if (window.scrollY > 80) {
      scrolledEnough = true;
      showPopup();
    } else if (scrolledEnough && !closedByUser) {
      hidePopup();
    }
  }

  closeButton.addEventListener("click", () => {
    closedByUser = true;
    hidePopup();
  });

  window.addEventListener("scroll", handleScroll, { passive: true });

  updateCountdown();
})();
</script>
</body>
</html>

