# This project is a plain static site (no bundler/build step), so the
# browser can't read a .env file directly — that's what config.js is for
# (see config.example.js). This file exists for two reasons:
#
#   1. Documentation: the exact two values you need, regardless of how
#      you end up wiring them in.
#   2. If you deploy with a host that supports build-time env injection
#      (Netlify, Vercel, Cloudflare Pages, a CI step, etc.), you can set
#      these there and have your build step generate config.js from them,
#      e.g.: echo "window.__SUPABASE_CONFIG__={url:'$SUPABASE_URL',anonKey:'$SUPABASE_ANON_KEY'};" > config.js

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-PUBLISHABLE-ANON-KEY
